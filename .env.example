# Local development database (SQLite). Swap to a postgresql:// URL later
# when moving off local mock mode — the schema is written to be portable.
DATABASE_URL="file:./dev.db"

# Base URL used to build public/private feed URLs during local development.
APP_URL="http://localhost:3000"

# Shopify OAuth credentials — from your Partner Dashboard app (Client ID /
# Client secret). SHOPIFY_APP_URL is the tunnel URL `shopify app dev` gives
# you (or your production URL); SCOPES matches shopify.app.toml.
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SHOPIFY_APP_URL=
# SCOPES=read_products,read_inventory

# true = skip real Shopify auth and use whatever shop is in the local DB
# (local dev before credentials are set up, and the test suites). Set to
# false once you're ready to install on a real development store.
MOCK_SHOPIFY="true"
